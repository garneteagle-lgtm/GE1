{
  "name": "case-manager",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "sunbiz:import": "tsx scripts/import-sunbiz.ts",
    "desktop:template": "cross-env DATABASE_URL=file:../resources/template.db prisma db push --skip-generate --accept-data-loss",
    "desktop:prepare": "npm run desktop:template && next build && node scripts/desktop-postbuild.mjs",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win nsis --publish never",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^5.22.0",
    "date-fns": "^4.1.0",
    "googleapis": "^144.0.0",
    "next": "^15.5.18",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ssh2-sftp-client": "^11.0.0",
    "unzipper": "^0.12.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ssh2-sftp-client": "^9.0.4",
    "@types/unzipper": "^0.10.10",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
