generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     Case[]
}

model Case {
  id           String          @id @default(cuid())
  title        String
  caseNumber   String?
  court        String?
  practiceArea String?
  status       String          @default("open")
  opposing     String?
  description  String?
  openedAt     DateTime        @default(now())
  closedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  notes        Note[]
  tasks        Task[]
  deadlines    Deadline[]
  emails       EmailMessage[]
  events       CalendarEvent[]
  documents    Document[]
}

// A business entity from Florida's official corporate registry (sunbiz.org
// "cordata" bulk data). Stored locally so we can look up who/where to serve
// when suing or subpoenaing the entity, without any per-query network call.
model Entity {
  id             String   @id @default(cuid())
  documentNumber String   @unique // FL document/registration number (6 or 12 chars)
  legalName      String
  nameKey        String // upper-cased legalName, for case-insensitive search/sort
  status         String? // "Active" / "Inactive"
  filingType     String? // decoded, e.g. "Florida Limited Liability Co."
  feiNumber      String? // FEI/EIN
  fileDate       String? // formation filing date, as stored (MM/DD/YYYY)

  // Principal place of business
  princAddr1   String?
  princAddr2   String?
  princCity    String?
  princState   String?
  princZip     String?
  princCountry String?

  // Mailing address
  mailAddr1   String?
  mailAddr2   String?
  mailCity    String?
  mailState   String?
  mailZip     String?
  mailCountry String?

  // Registered agent — the person/entity to serve with process
  raName  String?
  raType  String? // "Person" / "Corporation"
  raAddr1 String?
  raCity  String?
  raState String?
  raZip   String?

  source       String   @default("FL-SFTP") // provenance of the record
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([nameKey])
}

model Document {
  id           String   @id @default(cuid())
  filename     String
  storedName   String
  mimeType     String?
  size         Int
  description  String?
  uploadedAt   DateTime @default(now())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  done        Boolean   @default(false)
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Deadline {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime
  kind        String?
  createdAt   DateTime @default(now())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model EmailMessage {
  id        String   @id @default(cuid())
  gmailId   String   @unique
  threadId  String?
  fromAddr  String?
  toAddr    String?
  subject   String?
  sentAt    DateTime?
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model CalendarEvent {
  id            String    @id @default(cuid())
  googleEventId String    @unique
  summary       String?
  description   String?
  location      String?
  startAt       DateTime?
  endAt         DateTime?
  htmlLink      String?
  caseId        String?
  case          Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
