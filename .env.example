DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google Cloud OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated list of emails allowed to sign in. Leave blank during initial
# setup, then set it once your first sign-in succeeds. Add colleagues' emails
# here (e.g. "you@firm.com,paralegal@firm.com") when you want to invite them.
ALLOWED_EMAILS=""

# --- Flight finder (tools/flight-finder) ---------------------------------
# Free Self-Service credentials from https://developers.amadeus.com
# Leave blank to run `npm run flights -- --demo ...` with invented fares.
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
# "test" uses the free sandbox (cached fares, limited routes).
# "production" uses live fares; requires moving your Amadeus app to production.
AMADEUS_ENV="test"

