DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google Cloud OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated list of emails allowed to sign in. Leave blank during initial
# setup, then set it once your first sign-in succeeds. Add colleagues' emails
# here (e.g. "you@firm.com,paralegal@firm.com") when you want to invite them.
ALLOWED_EMAILS=""

# Entity lookup (service of process). The defaults point at Florida's free
# public corporate-data SFTP server, so you normally don't need to set these.
# Override only if the state changes the host/credentials or file paths.
# SUNBIZ_SFTP_HOST="sftp.floridados.gov"
# SUNBIZ_SFTP_USER="Public"
# SUNBIZ_SFTP_PASS="PubAccess1845!"
# SUNBIZ_SFTP_QUARTERLY="/Public/doc/cor/cordata.zip"
# SUNBIZ_SFTP_DAILY_DIR="/Public/doc/cor"
