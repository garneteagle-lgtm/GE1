DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google Cloud OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated list of emails allowed to sign in. Leave blank during initial
# setup, then set it once your first sign-in succeeds. Add colleagues' emails
# here (e.g. "you@firm.com,paralegal@firm.com") when you want to invite them.
ALLOWED_EMAILS=""

# Shared secret the Apple Mail "Court Filing Alert" script uses to send filing
# notices to the app. Generate with: openssl rand -hex 32
# Leave blank to disable the ingest endpoint.
FILING_INGEST_TOKEN=""
